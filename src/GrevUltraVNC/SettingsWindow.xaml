<Window x:Class="GrevUltraVNC.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:GrevUltraVNC.Services"
        Title="GrevUltraVNC Settings" Width="650" Height="720" MinHeight="620" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Style="{StaticResource AppWindowStyle}"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextBrush}">
    <Window.Resources>
        <Style x:Key="CollaborationColourButton" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderBrush" Value="#66708090" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Swatch"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Swatch" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Swatch" Property="Opacity" Value="0.62" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="28" Background="{DynamicResource WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="58" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="48" Height="48" CornerRadius="12" Background="#05070B" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Image Source="{x:Static svc:BrandAssets.Logo}" Margin="3" Stretch="Uniform" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                <TextBlock Text="Settings" FontSize="27" FontWeight="Bold" />
                <TextBlock Text="Identity, appearance, startup, UltraVNC viewer and monitoring preferences." Foreground="{DynamicResource MutedTextBrush}" Margin="0,3,0,0" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,24,0,20">
            <StackPanel>
                <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
                    <StackPanel>
                        <TextBlock Text="GREV COLLABORATION" Foreground="{DynamicResource AccentBrush}" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Text="Your Grev Name" Margin="0,10,0,6" />
                        <TextBox x:Name="GrevNameBox" MaxLength="40" />
                        <TextBlock Text="Shown to other GrevUltraVNC users when you are connected to the same machine."
                                   Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,7,0,0" TextWrapping="Wrap" />

                        <TextBlock Text="Preferred session colour" Margin="0,16,0,6" />
                        <TextBlock Text="GrevUltraVNC tries to give you this colour when you join. If somebody already has it, the Agent assigns the next free colour for that session only."
                                   Foreground="{DynamicResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" />
                        <Grid Margin="0,9,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <UniformGrid x:Name="CollaborationColourPalette" Columns="8" Rows="2">
                                <Button x:Name="DefaultCollaborationColourButton" Style="{StaticResource CollaborationColourButton}" Background="#32CFF0" Tag="#32CFF0" ToolTip="Grev cyan" Click="CollaborationColour_Click" />
                                <Button Style="{StaticResource CollaborationColourButton}" Background="#8C7CFF" Tag="#8C7CFF" ToolTip="Violet" Click="CollaborationColour_Click" />
                                <Button Style="{StaticResource CollaborationColourButton}" Background="#50DC91" Tag="#50DC91" ToolTip="Green" Click="CollaborationColour_Click" />
                                <Button Style="{StaticResource CollaborationColourButton}" Background="#FFB84D" Tag="#FFB84D" ToolTip="Orange" Click="CollaborationColour_Click" />
                                <Button Style="{StaticResource CollaborationColourButton}" Background="#FF6B8A" Tag="#FF6B8A" ToolTip="Pink" Click="CollaborationColour_Click" />
                                <Button Style="{StaticResource CollaborationColourButton}" Background="#5EA8FF" Tag="#5EA8FF" ToolTip="Blue" Click="CollaborationColour_Click" />
                                <Button Style="{StaticResource CollaborationColourButton}" Background="#FFE066" Tag="#FFE066" ToolTip="Yellow" Click="CollaborationColour_Click" />
                                <Button Style="{StaticResource CollaborationColourButton}" Background="#2DD4BF" Tag="#2DD4BF" ToolTip="Teal" Click="CollaborationColour_Click" />
                                <Button Style="{StaticResource CollaborationColourButton}" Background="#FF4D5E" Tag="#FF4D5E" ToolTip="Red" Click="CollaborationColour_Click" />
                                <Button Style="{StaticResource CollaborationColourButton}" Background="#A3E635" Tag="#A3E635" ToolTip="Lime" Click="CollaborationColour_Click" />
                                <Button Style="{StaticResource CollaborationColourButton}" Background="#EC4899" Tag="#EC4899" ToolTip="Magenta" Click="CollaborationColour_Click" />
                                <Button Style="{StaticResource CollaborationColourButton}" Background="#A855F7" Tag="#A855F7" ToolTip="Purple" Click="CollaborationColour_Click" />
                                <Button Style="{StaticResource CollaborationColourButton}" Background="#6366F1" Tag="#6366F1" ToolTip="Indigo" Click="CollaborationColour_Click" />
                                <Button Style="{StaticResource CollaborationColourButton}" Background="#38BDF8" Tag="#38BDF8" ToolTip="Sky" Click="CollaborationColour_Click" />
                                <Button Style="{StaticResource CollaborationColourButton}" Background="#F59E0B" Tag="#F59E0B" ToolTip="Amber" Click="CollaborationColour_Click" />
                                <Button Style="{StaticResource CollaborationColourButton}" Background="#6EE7B7" Tag="#6EE7B7" ToolTip="Mint" Click="CollaborationColour_Click" />
                            </UniformGrid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                <TextBlock Text="SELECTED" Foreground="{DynamicResource FaintTextBrush}" FontSize="8" FontWeight="SemiBold" />
                                <TextBlock x:Name="SelectedCollaborationColourText" Text="Grev cyan" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>

                        <TextBlock x:Name="ControllerIdText" Foreground="{DynamicResource FaintTextBrush}" FontSize="10" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="APPEARANCE" Foreground="{DynamicResource AccentBrush}" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Text="Theme" Margin="0,10,0,6" />
                        <UniformGrid Columns="2" Width="320" HorizontalAlignment="Left">
                            <RadioButton x:Name="DarkThemeRadio" GroupName="Theme" Style="{StaticResource ThemeChoice}"
                                         Content="☾  Dark" Margin="0,0,5,0" Checked="ThemeChoice_Checked" />
                            <RadioButton x:Name="LightThemeRadio" GroupName="Theme" Style="{StaticResource ThemeChoice}"
                                         Content="☀  Light" Margin="5,0,0,0" Checked="ThemeChoice_Checked" />
                        </UniformGrid>
                        <TextBlock Text="Changes preview immediately. Dark mode is the default." Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,7,0,0" />
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="APP BEHAVIOUR" Foreground="{DynamicResource AccentBrush}" FontSize="12" FontWeight="SemiBold" />
                        <CheckBox x:Name="StartWithWindowsCheck" Content="Start GrevUltraVNC with Windows" Margin="0,12,0,0" />
                        <CheckBox x:Name="MinimizeToTrayCheck" Content="Minimise to the GrevUltraVNC system tray icon" Margin="0,12,0,0" />
                        <TextBlock Text="Favourite machines appear as quick-connect entries in the tray menu." Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="ULTRAVNC" Foreground="{DynamicResource AccentBrush}" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Text="UltraVNC Viewer path" Margin="0,10,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ViewerPathBox" />
                            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Browse" Click="Browse_Click" Margin="10,0,0,0" />
                        </Grid>
                        <Button Style="{StaticResource SecondaryButton}" Content="Auto-detect UltraVNC Viewer" Click="Detect_Click"
                                HorizontalAlignment="Left" Margin="0,10,0,0" />

                        <CheckBox x:Name="AutoScaleCheck" Content="Auto scale remote desktop" Margin="0,20,0,0" />
                        <CheckBox x:Name="FullScreenCheck" Content="Open VNC fullscreen by default" Margin="0,12,0,0" />

                        <TextBlock Text="Machine status check interval (seconds)" Margin="0,20,0,6" />
                        <TextBox x:Name="IntervalBox" Width="100" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource SecondaryButton}" Content="Cancel" IsCancel="True" Margin="0,0,10,0" />
            <Button Style="{StaticResource PrimaryButton}" Content="Save settings" Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
