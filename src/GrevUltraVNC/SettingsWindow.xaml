<Window x:Class="GrevUltraVNC.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="620" Height="470" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Settings" FontSize="26" FontWeight="Bold" />
            <TextBlock Text="UltraVNC viewer and monitoring preferences." Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,24,0,20">
            <TextBlock Text="UltraVNC Viewer path" Margin="0,0,0,6" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="ViewerPathBox" />
                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Browse" Click="Browse_Click" Margin="10,0,0,0" />
            </Grid>
            <Button Style="{StaticResource SecondaryButton}" Content="Auto-detect UltraVNC Viewer" Click="Detect_Click"
                    HorizontalAlignment="Left" Margin="0,10,0,0" />

            <CheckBox x:Name="AutoScaleCheck" Content="Auto scale remote desktop" Margin="0,24,0,0" />
            <CheckBox x:Name="FullScreenCheck" Content="Open VNC fullscreen by default" Margin="0,12,0,0" />

            <TextBlock Text="Machine status check interval (seconds)" Margin="0,24,0,6" />
            <TextBox x:Name="IntervalBox" Width="100" HorizontalAlignment="Left" />
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource SecondaryButton}" Content="Cancel" IsCancel="True" Margin="0,0,10,0" />
            <Button Style="{StaticResource PrimaryButton}" Content="Save settings" Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
