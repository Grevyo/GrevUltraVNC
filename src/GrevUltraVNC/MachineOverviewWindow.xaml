<Window x:Class="GrevUltraVNC.MachineOverviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:GrevUltraVNC.Services"
        Title="GrevUltraVNC · Manage"
        Width="1120" Height="790" MinWidth="940" MinHeight="650"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource AppWindowStyle}"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextBrush}">
    <Window.Resources>
        <Style x:Key="ManageSurface" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="13" />
        </Style>
        <Style x:Key="ManageSmallButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Padding" Value="11,7" />
            <Setter Property="MinHeight" Value="36" />
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Compact machine identity -->
        <Border Background="{DynamicResource SubtlePanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1" Padding="22,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="40" Height="40" CornerRadius="11" Background="#030509"
                        BorderBrush="{DynamicResource Accent2Brush}" BorderThickness="1">
                    <Image Source="{x:Static svc:BrandAssets.Logo}" Margin="3" Stretch="Uniform" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="9,0,12,0">
                    <TextBlock Text="MANAGE" Foreground="{DynamicResource AccentBrush}" FontSize="9" FontWeight="Bold" />
                    <TextBlock x:Name="MachineNameText" FontSize="22" FontWeight="SemiBold" Margin="0,1,0,0" />
                    <TextBlock x:Name="MachineAddressText" Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="10" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="9" Padding="9,7" Margin="0,0,8,0">
                        <TextBlock x:Name="AgentStateText" Text="● CHECKING AGENT"
                                   Foreground="{DynamicResource MutedTextBrush}" FontSize="10" FontWeight="SemiBold" />
                    </Border>
                    <Button x:Name="RefreshScreenButton" Style="{StaticResource ManageSmallButton}"
                            Content="Refresh screen" Click="RefreshScreen_Click" Margin="0,0,7,0" />
                    <Button Style="{StaticResource ManageSmallButton}" Content="Refresh data" Click="Refresh_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Navigation -->
        <Border Grid.Row="1" Margin="22,14,22,12" Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="7">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="OverviewButton" Style="{StaticResource PrimaryButton}" Content="Overview" Click="OverviewTab_Click" Margin="0,0,5,0" Padding="12,7" />
                <Button x:Name="ProcessesButton" Style="{StaticResource SecondaryButton}" Content="Processes" Click="ProcessesTab_Click" Margin="0,0,5,0" Padding="12,7" />
                <Button x:Name="ServicesButton" Style="{StaticResource SecondaryButton}" Content="Services" Click="ServicesTab_Click" Margin="0,0,5,0" Padding="12,7" />
                <Button x:Name="SessionButton" Style="{StaticResource SecondaryButton}" Content="Session" Click="SessionTab_Click" Margin="0,0,5,0" Padding="12,7" />
                <Button Style="{StaticResource SecondaryButton}" Content="Files" Click="Files_Click" Margin="0,0,5,0" Padding="12,7" />
                <Button x:Name="ToolsButton" Style="{StaticResource SecondaryButton}" Content="Tools" Click="ToolsTab_Click" Margin="0,0,5,0" Padding="12,7" />
                <Button x:Name="TerminalButton" Style="{StaticResource SecondaryButton}" Content="Terminal" Click="TerminalTab_Click" Margin="0,0,5,0" Padding="12,7" />
                <Button x:Name="ActivityButton" Style="{StaticResource SecondaryButton}" Content="Activity" Click="ActivityTab_Click" Padding="12,7" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="22,0,22,14">
            <!-- OVERVIEW -->
            <Grid x:Name="OverviewPanel">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <UniformGrid Columns="4" Margin="0,0,0,10">
                    <Border Style="{StaticResource ManageSurface}" Padding="14" Margin="0,0,5,0">
                        <StackPanel>
                            <TextBlock Text="CPU" Foreground="{DynamicResource FaintTextBrush}" FontSize="9" FontWeight="SemiBold" />
                            <TextBlock x:Name="CpuUsageText" Text="—" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0" />
                            <TextBlock x:Name="CpuNameText" Text="Waiting for Agent" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" FontSize="9" Margin="0,3,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource ManageSurface}" Padding="14" Margin="5,0">
                        <StackPanel>
                            <TextBlock Text="MEMORY" Foreground="{DynamicResource FaintTextBrush}" FontSize="9" FontWeight="SemiBold" />
                            <TextBlock x:Name="MemoryUsageText" Text="—" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0" />
                            <TextBlock x:Name="MemoryDetailText" Text="Waiting for Agent" Foreground="{DynamicResource MutedTextBrush}" FontSize="9" Margin="0,3,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource ManageSurface}" Padding="14" Margin="5,0">
                        <StackPanel>
                            <TextBlock Text="UPTIME" Foreground="{DynamicResource FaintTextBrush}" FontSize="9" FontWeight="SemiBold" />
                            <TextBlock x:Name="UptimeText" Text="—" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0" />
                            <TextBlock x:Name="UserText" Text="Waiting for Agent" Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis" FontSize="9" Margin="0,3,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource ManageSurface}" Padding="14" Margin="5,0,0,0">
                        <StackPanel>
                            <TextBlock Text="ULTRAVNC" Foreground="{DynamicResource FaintTextBrush}" FontSize="9" FontWeight="SemiBold" />
                            <TextBlock x:Name="VncServiceText" Text="—" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0" />
                            <TextBlock x:Name="VncPortText" Text="Waiting for Agent" Foreground="{DynamicResource MutedTextBrush}" FontSize="9" Margin="0,3,0,0" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource ManageSurface}" Padding="15" Margin="0,0,5,0">
                        <StackPanel>
                            <TextBlock Text="SYSTEM" Foreground="{DynamicResource AccentBrush}" FontSize="9" FontWeight="SemiBold" />
                            <TextBlock x:Name="OsText" Text="Waiting for Grev Agent…" FontSize="13" FontWeight="SemiBold" Margin="0,7,0,0" TextWrapping="Wrap" />
                            <TextBlock x:Name="HostText" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" Margin="0,4,0,0" />
                            <TextBlock x:Name="AgentVersionText" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource ManageSurface}" Padding="15" Margin="5,0,0,0">
                        <StackPanel>
                            <TextBlock Text="INVENTORY" Foreground="{DynamicResource Accent2Brush}" FontSize="9" FontWeight="SemiBold" />
                            <TextBlock x:Name="ProcessSummaryText" Text="Processes: —" Margin="0,7,0,0" FontSize="11" />
                            <TextBlock x:Name="ServiceSummaryText" Text="Services: —" Margin="0,4,0,0" FontSize="11" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Row="2" Style="{StaticResource ManageSurface}" Padding="15">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="DISKS" Foreground="{DynamicResource AccentBrush}" FontSize="9" FontWeight="SemiBold" Margin="0,0,0,7" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="DiskItems">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="150" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="1" Text="{Binding Label}" Foreground="{DynamicResource MutedTextBrush}" />
                                            <TextBlock Grid.Column="2" Text="{Binding Space}" HorizontalAlignment="Right" Foreground="{DynamicResource MutedTextBrush}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- PROCESSES -->
            <Grid x:Name="ProcessesPanel" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBox x:Name="ProcessSearchBox" Width="340" HorizontalAlignment="Left" TextChanged="ProcessSearchBox_TextChanged" ToolTip="Filter processes by name or PID" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="ProcessCountText" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,12,0" />
                        <Button Style="{StaticResource DangerButton}" Content="End selected" Click="EndProcess_Click" Padding="12,7" />
                    </StackPanel>
                </Grid>
                <Border Grid.Row="1" Style="{StaticResource ManageSurface}" Padding="12">
                    <ListView x:Name="ProcessesList" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextBrush}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="3,5" Width="960">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3*" /><ColumnDefinition Width="80" /><ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="120" /><ColumnDefinition Width="100" /><ColumnDefinition Width="2*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{Binding Pid}" Foreground="{DynamicResource MutedTextBrush}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Memory}" Foreground="{DynamicResource MutedTextBrush}" />
                                    <TextBlock Grid.Column="3" Text="{Binding CpuTime}" Foreground="{DynamicResource MutedTextBrush}" />
                                    <TextBlock Grid.Column="4" Text="{Binding Session}" Foreground="{DynamicResource MutedTextBrush}" />
                                    <TextBlock Grid.Column="5" Text="{Binding Started}" Foreground="{DynamicResource FaintTextBrush}" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>
            </Grid>

            <!-- SERVICES -->
            <Grid x:Name="ServicesPanel" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBox x:Name="ServiceSearchBox" Width="340" HorizontalAlignment="Left" TextChanged="ServiceSearchBox_TextChanged" ToolTip="Filter services by name, display name or state" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="ServiceCountText" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,12,0" />
                        <Button Style="{StaticResource ManageSmallButton}" Content="Start" Click="StartService_Click" Margin="0,0,6,0" />
                        <Button Style="{StaticResource ManageSmallButton}" Content="Restart" Click="RestartService_Click" Margin="0,0,6,0" />
                        <Button Style="{StaticResource DangerButton}" Content="Stop" Click="StopService_Click" Padding="11,7" />
                    </StackPanel>
                </Grid>
                <Border Grid.Row="1" Style="{StaticResource ManageSurface}" Padding="12">
                    <ListView x:Name="ServicesList" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextBrush}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="3,5" Width="960">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3*" /><ColumnDefinition Width="2*" /><ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="130" /><ColumnDefinition Width="110" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{Binding ServiceName}" Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{Binding Status}" Foreground="{DynamicResource MutedTextBrush}" />
                                    <TextBlock Grid.Column="3" Text="{Binding StartMode}" Foreground="{DynamicResource MutedTextBrush}" />
                                    <TextBlock Grid.Column="4" Text="{Binding Control}" Foreground="{DynamicResource FaintTextBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>
            </Grid>

            <!-- SESSION -->
            <Grid x:Name="SessionPanel" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Border Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource Accent2Brush}" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,0,10">
                    <TextBlock x:Name="SessionFeatureStatusText" Text="Checking Agent capability…" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" TextWrapping="Wrap" />
                </Border>
                <Grid x:Name="SessionActionsPanel" Grid.Row="1" IsEnabled="False">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource ManageSurface}" Padding="16" Margin="0,0,5,0">
                        <StackPanel>
                            <TextBlock Text="WINDOWS SESSION" Foreground="{DynamicResource AccentBrush}" FontSize="9" FontWeight="SemiBold" Margin="0,0,0,11" />
                            <Button Style="{StaticResource PrimaryButton}" Content="Lock workstation" Click="LockSession_Click" Margin="0,0,0,7" />
                            <Button Style="{StaticResource SecondaryButton}" Content="Restart Explorer" Click="RestartExplorer_Click" Margin="0,0,0,7" />
                            <Button Style="{StaticResource DangerButton}" Content="Sign out active user" Click="SignOutSession_Click" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource ManageSurface}" Padding="16" Margin="5,0,0,0">
                        <StackPanel>
                            <TextBlock Text="POWER STATE" Foreground="{DynamicResource Accent2Brush}" FontSize="9" FontWeight="SemiBold" Margin="0,0,0,11" />
                            <Button Style="{StaticResource SecondaryButton}" Content="Sleep machine" Click="SleepSession_Click" Margin="0,0,0,7" />
                            <Button Style="{StaticResource SecondaryButton}" Content="Hibernate machine" Click="HibernateSession_Click" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- TOOLS -->
            <Grid x:Name="ToolsPanel" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="2*" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Border Style="{StaticResource ManageSurface}" Padding="12" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="QUICK ADMIN" Foreground="{DynamicResource AccentBrush}" FontSize="9" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <UniformGrid Columns="4">
                            <Button Style="{StaticResource CardActionButton}" Content="Flush DNS" Click="FlushDns_Click" Margin="0,0,5,5" />
                            <Button Style="{StaticResource CardActionButton}" Content="Restart Spooler" Click="RestartSpooler_Click" Margin="5,0,5,5" />
                            <Button Style="{StaticResource CardActionButton}" Content="Network config" Click="NetworkConfig_Click" Margin="5,0,5,5" />
                            <Button Style="{StaticResource CardActionButton}" Content="Disk space" Click="DiskSpace_Click" Margin="5,0,0,5" />
                            <Button Style="{StaticResource CardActionButton}" Content="Windows Update" Click="WindowsUpdateScan_Click" Margin="0,5,5,0" />
                            <Button Style="{StaticResource CardActionButton}" Content="Restart UltraVNC" Click="RestartVncTool_Click" Margin="5,5,5,0" />
                            <Button x:Name="UpdateAgentButton" Style="{StaticResource PrimaryButton}" Content="Update Agent" Click="UpdateAgent_Click" IsEnabled="False" Margin="5,5,0,0" />
                        </UniformGrid>
                    </StackPanel>
                </Border>
                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="280" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource ManageSurface}" Padding="12" Margin="0,0,5,0">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <Grid>
                                <TextBlock Text="SAVED COMMANDS" Foreground="{DynamicResource Accent2Brush}" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Button Style="{StaticResource CardActionButton}" Content="+ New" Click="NewSavedCommand_Click" HorizontalAlignment="Right" Padding="9,5" />
                            </Grid>
                            <ListView x:Name="SavedCommandsList" Grid.Row="1" Margin="0,8,0,0" Background="Transparent" BorderThickness="0" SelectionChanged="SavedCommandsList_SelectionChanged">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="4">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Shell}" Foreground="{DynamicResource FaintTextBrush}" FontSize="9" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource ManageSurface}" Padding="12" Margin="5,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="150" /></Grid.ColumnDefinitions>
                                <TextBox x:Name="SavedCommandNameBox" Margin="0,0,8,0" ToolTip="Saved command name" />
                                <ComboBox x:Name="SavedCommandShellBox" Grid.Column="1" SelectedIndex="0">
                                    <ComboBoxItem Content="PowerShell" Tag="powershell" /><ComboBoxItem Content="CMD" Tag="cmd" />
                                </ComboBox>
                            </Grid>
                            <TextBox x:Name="SavedCommandTextBox" Grid.Row="1" Margin="0,8" AcceptsReturn="True" AcceptsTab="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" TextWrapping="NoWrap" />
                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="DeleteSavedCommandButton" Style="{StaticResource DangerButton}" Content="Delete" Click="DeleteSavedCommand_Click" Padding="11,7" Margin="0,0,6,0" />
                                <Button x:Name="SaveSavedCommandButton" Style="{StaticResource SecondaryButton}" Content="Save" Click="SaveSavedCommand_Click" Padding="12,7" Margin="0,0,6,0" />
                                <Button x:Name="RunSavedCommandButton" Style="{StaticResource PrimaryButton}" Content="Run" Click="RunSavedCommand_Click" Padding="13,7" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
                <Border Grid.Row="2" Background="#05070B" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <TextBlock Text="OUTPUT" Foreground="{DynamicResource AccentBrush}" FontSize="9" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <TextBox x:Name="ToolOutputBox" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" AcceptsTab="True" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextBrush}" FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Text="Grev admin tools ready.&#x0a;" />
                    </Grid>
                </Border>
            </Grid>

            <!-- TERMINAL -->
            <Grid x:Name="TerminalPanel" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Border Style="{StaticResource ManageSurface}" Padding="11" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <ComboBox x:Name="TerminalShellBox" SelectedIndex="0" Margin="0,0,8,0" Padding="8">
                            <ComboBoxItem Content="PowerShell" Tag="powershell" /><ComboBoxItem Content="CMD" Tag="cmd" />
                        </ComboBox>
                        <TextBox x:Name="TerminalCommandBox" Grid.Column="1" Margin="0,0,8,0" Padding="10,8" KeyDown="TerminalCommandBox_KeyDown" ToolTip="Enter a command and press Enter" />
                        <Button x:Name="RunCommandButton" Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="Run" Click="RunCommand_Click" Padding="14,8" />
                    </Grid>
                </Border>
                <TextBlock Grid.Row="1" Text="Runs as the Grev Agent service account · maximum runtime 30 seconds."
                           Foreground="{DynamicResource FaintTextBrush}" FontSize="9" Margin="2,0,0,8" />
                <Border Grid.Row="2" Background="#05070B" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="10">
                    <TextBox x:Name="TerminalOutputBox" IsReadOnly="True" AcceptsReturn="True" AcceptsTab="True" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextBrush}" FontFamily="Consolas" FontSize="13" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Text="Grev Agent terminal ready.&#x0a;" />
                </Border>
            </Grid>

            <!-- ACTIVITY -->
            <Grid x:Name="ActivityPanel" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid Margin="0,0,0,9">
                    <TextBlock x:Name="ActivitySummaryText" Text="Activity history for this machine" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                    <Button Style="{StaticResource DangerButton}" Content="Clear history" Click="ClearActivity_Click" Padding="11,7" HorizontalAlignment="Right" />
                </Grid>
                <Border Grid.Row="1" Style="{StaticResource ManageSurface}" Padding="12">
                    <ListView x:Name="ActivityList" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextBrush}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="3,6" Width="980">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="130" /><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Time}" Foreground="{DynamicResource FaintTextBrush}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Category}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="2" Text="{Binding Action}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="3" Text="{Binding Detail}" Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="4" Text="{Binding Result}" Foreground="{DynamicResource FaintTextBrush}" HorizontalAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="3" Background="{DynamicResource SubtlePanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="22,9">
            <TextBlock x:Name="StatusText" Text="Ready" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" />
        </Border>
    </Grid>
</Window>
