<Window x:Class="GrevUltraVNC.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:GrevUltraVNC.Converters"
        Title="GrevUltraVNC" Width="1080" Height="720" MinWidth="800" MinHeight="520"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <conv:MachineStatusBrushConverter x:Key="StatusBrushConverter" />
    </Window.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Text="GrevUltraVNC" FontSize="30" FontWeight="Bold" />
                <TextBlock Text="Your LAN machines" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Style="{StaticResource SecondaryButton}" Content="Settings" Click="Settings_Click" Margin="0,0,10,0" />
                <Button Style="{StaticResource PrimaryButton}" Content="＋ Add PC" Click="AddMachine_Click" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="#12151B" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="10" Padding="14,10" Margin="0,24,0,18">
            <TextBlock Foreground="{StaticResource MutedTextBrush}"
                       Text="Double-click a machine for VNC, power, file and diagnostics actions." />
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Machines}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="295" Height="180" Margin="0,0,16,16" Padding="18"
                                Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="12" Cursor="Hand"
                                MouseLeftButtonDown="MachineCard_MouseLeftButtonDown">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <TextBlock Text="🖥" FontSize="22" />
                                    <TextBlock Text="{Binding StatusText}" HorizontalAlignment="Right"
                                               Foreground="{Binding Status, Converter={StaticResource StatusBrushConverter}}"
                                               FontWeight="SemiBold" FontSize="12" />
                                </Grid>
                                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="21" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding IpAddress}" Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0" />
                                    <TextBlock Text="{Binding Group}" Foreground="#788394" FontSize="12" Margin="0,4,0,0" />
                                </StackPanel>
                                <TextBlock Grid.Row="2" Text="{Binding DetailText}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <TextBlock x:Name="FooterStatus" Foreground="{StaticResource MutedTextBrush}" Text="Ready" />
            <TextBlock HorizontalAlignment="Right" Foreground="#626C7A" Text="LAN-only remote management" />
        </Grid>
    </Grid>
</Window>
