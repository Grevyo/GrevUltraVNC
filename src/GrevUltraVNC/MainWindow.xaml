<Window x:Class="GrevUltraVNC.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:GrevUltraVNC.Converters"
        xmlns:svc="clr-namespace:GrevUltraVNC.Services"
        Title="GrevUltraVNC" Width="1220" Height="820" MinWidth="920" MinHeight="620"
        Style="{StaticResource AppWindowStyle}"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextBrush}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <conv:MachineStatusBrushConverter x:Key="StatusBrushConverter" />
        <conv:AgentStateBrushConverter x:Key="AgentStateBrushConverter" />

        <Style x:Key="HeaderAction" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <Style x:Key="MainFilterButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Margin" Value="3,0" />
        </Style>

        <Style x:Key="MainFilterActiveButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Margin" Value="3,0" />
        </Style>

        <Style x:Key="MachineMetaLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource FaintTextBrush}" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource SubtlePanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="52" Height="52" CornerRadius="14"
                        Background="#030509"
                        BorderBrush="{DynamicResource Accent2Brush}"
                        BorderThickness="1">
                    <Image Source="{x:Static svc:BrandAssets.Logo}" Margin="3" Stretch="Uniform" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="13,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Grev" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock Text="UltraVNC" FontSize="26" FontWeight="Bold" Margin="1,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="Remote control, machine management and Grev Connect"
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="11" Margin="1,2,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource HeaderAction}" Content="↻  Refresh" Click="Refresh_Click" Margin="0,0,7,0" />
                    <Button Style="{StaticResource HeaderAction}" Content="⚙  Settings" Click="Settings_Click" Margin="0,0,7,0" />
                    <Button Style="{StaticResource PrimaryButton}" Content="◇  Connect by ID" Click="QuickConnect_Click"
                            Padding="14,8" MinHeight="38" FontSize="11" Margin="0,0,7,0" />
                    <Button Style="{StaticResource HeaderAction}" Content="＋  Add PC" Click="AddMachine_Click"
                            Padding="14,8" MinHeight="38" FontSize="11" ToolTip="Advanced/manual machine setup" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="24,16,24,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                <TextBlock Text="MACHINES" Foreground="{DynamicResource AccentBrush}" FontSize="10" FontWeight="Bold" />
                <TextBlock x:Name="FilterSummaryText" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,2,0,0" />
            </StackPanel>

            <Border Grid.Column="1" MaxWidth="540" HorizontalAlignment="Stretch"
                    Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="11" Margin="0,0,14,0">
                <Grid>
                    <TextBox x:Name="SearchBox"
                             TextChanged="SearchBox_TextChanged"
                             ToolTip="Search name, Grev Connect ID, IP, group or notes"
                             Padding="35,10,11,10" BorderThickness="0" Background="Transparent" />
                    <TextBlock Text="⌕" FontSize="18" Foreground="{DynamicResource FaintTextBrush}"
                               Margin="11,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                               IsHitTestVisible="False" />
                </Grid>
            </Border>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="AllFilterButton" Style="{StaticResource MainFilterActiveButton}"
                        Content="All" Tag="all" Click="MachineFilter_Click" />
                <Button x:Name="OnlineFilterButton" Style="{StaticResource MainFilterButton}"
                        Content="Online" Tag="online" Click="MachineFilter_Click" />
                <Button x:Name="OfflineFilterButton" Style="{StaticResource MainFilterButton}"
                        Content="Offline" Tag="offline" Click="MachineFilter_Click" />
                <Button x:Name="FavoritesFilterButton" Style="{StaticResource MainFilterButton}"
                        Content="★ Favourites" Tag="favorites" Click="MachineFilter_Click" Margin="3,0,0,0" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Background="{DynamicResource WindowBrush}"
                          Margin="24,0,10,0">
                <ItemsControl ItemsSource="{Binding MachinesView}" Background="{DynamicResource WindowBrush}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="360" Height="244" Margin="0,0,14,14"
                                    Style="{StaticResource MachineCardStyle}" Cursor="Hand"
                                    MouseLeftButtonDown="MachineCard_MouseLeftButtonDown"
                                    MouseRightButtonUp="MachineCard_MouseRightButtonUp">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="3" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Border Background="{StaticResource BrandGradientBrush}" CornerRadius="13,13,0,0" />

                                    <Grid Grid.Row="1" Margin="15,12,15,13">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Grid>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Style="{StaticResource IconButton}" Content="{Binding FavoriteGlyph}"
                                                        Click="FavoriteMachine_Click" ToolTip="Toggle favourite"
                                                        Padding="7,4" MinWidth="32" Margin="0,0,7,0" />
                                                <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="7" Padding="8,4" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Group}" Foreground="{DynamicResource AccentBrush}" FontSize="9" FontWeight="SemiBold" />
                                                </Border>
                                            </StackPanel>

                                            <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                                                    Background="{DynamicResource SubtlePanelBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1" CornerRadius="7" Padding="8,4">
                                                <TextBlock Text="{Binding StatusText}"
                                                           Foreground="{Binding Status, Converter={StaticResource StatusBrushConverter}}"
                                                           FontWeight="SemiBold" FontSize="9" />
                                            </Border>
                                        </Grid>

                                        <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="2,6,2,6">
                                            <TextBlock Text="{Binding Name}" FontSize="21" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding ConnectDisplayText}" Foreground="{DynamicResource AccentBrush}"
                                                       FontSize="10" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />

                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding DetailText}" Foreground="{DynamicResource MutedTextBrush}"
                                                           FontSize="10" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" Text="{Binding LastCheckedText}"
                                                           Foreground="{DynamicResource FaintTextBrush}"
                                                           FontSize="9" Margin="10,0,0,0" />
                                            </Grid>

                                            <Border Background="{DynamicResource SubtlePanelBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1" CornerRadius="9"
                                                    Padding="9,7" Margin="0,8,0,0"
                                                    ToolTip="{Binding AgentMessage}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding AgentStatusText}"
                                                               Foreground="{Binding AgentState, Converter={StaticResource AgentStateBrushConverter}}"
                                                               FontSize="9" FontWeight="SemiBold"
                                                               VerticalAlignment="Center" Margin="0,0,9,0" />
                                                    <TextBlock Grid.Column="1" Text="{Binding AgentSummaryText}"
                                                               Foreground="{DynamicResource MutedTextBrush}"
                                                               FontSize="9" TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </StackPanel>

                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Button Style="{StaticResource PrimaryButton}" Content="Connect" Click="ConnectMachine_Click"
                                                    Margin="0,0,6,0" Padding="12,7" FontSize="11" />
                                            <Button Grid.Column="1" Style="{StaticResource CardActionButton}" Content="Manage"
                                                    Click="ManageMachine_Click" Margin="0,0,6,0" />
                                            <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="⋯"
                                                    Click="MoreMachine_Click" ToolTip="Edit and more machine actions" Padding="8,5" MinWidth="34" />
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border x:Name="EmptyStatePanel" Visibility="Collapsed"
                    Width="430" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="16" Padding="28">
                <StackPanel>
                    <TextBlock Text="◇" HorizontalAlignment="Center" FontSize="32"
                               Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,10" />
                    <TextBlock x:Name="EmptyStateTitle" Text="No machines yet"
                               HorizontalAlignment="Center" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock x:Name="EmptyStateDetail"
                               Text="Got a GC- ID? Use Connect by ID and GrevUltraVNC will find the current route for you."
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                               Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,6,0,0" />
                    <Button Style="{StaticResource PrimaryButton}" Content="◇  Connect by GrevConnect ID"
                            Click="QuickConnect_Click" HorizontalAlignment="Center" Margin="0,16,0,0" Padding="15,8" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="3" Background="{DynamicResource SubtlePanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="24,9">
            <Grid>
                <TextBlock x:Name="FooterStatus" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" Text="Ready" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="Double-click a card to connect" Foreground="{DynamicResource FaintTextBrush}" FontSize="10" Margin="0,0,18,0" />
                    <TextBlock Text="LAN  •  Grev Connect" Foreground="{DynamicResource FaintTextBrush}" FontSize="10" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>