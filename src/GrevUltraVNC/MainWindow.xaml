<Window x:Class="GrevUltraVNC.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:GrevUltraVNC.Converters"
        Title="GrevUltraVNC" Width="1080" Height="720" MinWidth="800" MinHeight="520"
        Style="{StaticResource AppWindowStyle}"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextBrush}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <conv:MachineStatusBrushConverter x:Key="StatusBrushConverter" />
    </Window.Resources>

    <Grid Margin="28" Background="{DynamicResource WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Text="GrevUltraVNC" FontSize="30" FontWeight="Bold" />
                <TextBlock Text="Your LAN machines" Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Style="{StaticResource SecondaryButton}" Content="Settings" Click="Settings_Click" Margin="0,0,10,0" />
                <Button Style="{StaticResource PrimaryButton}" Content="＋ Add PC" Click="AddMachine_Click" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="{DynamicResource SubtlePanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="10" Padding="14,10" Margin="0,24,0,18">
            <TextBlock Foreground="{DynamicResource MutedTextBrush}"
                       Text="Double-click a machine to connect immediately. Use Edit on the card to change its details or VNC password." />
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Background="{DynamicResource WindowBrush}">
            <ItemsControl ItemsSource="{Binding Machines}" Background="{DynamicResource WindowBrush}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="295" Height="180" Margin="0,0,16,16" Padding="18"
                                Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="12" Cursor="Hand"
                                MouseLeftButtonDown="MachineCard_MouseLeftButtonDown">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <TextBlock Text="🖥" FontSize="22" />
                                    <TextBlock Text="{Binding StatusText}" HorizontalAlignment="Right"
                                               Foreground="{Binding Status, Converter={StaticResource StatusBrushConverter}}"
                                               FontWeight="SemiBold" FontSize="12" />
                                </Grid>
                                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="21" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding IpAddress}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,5,0,0" />
                                    <TextBlock Text="{Binding Group}" Foreground="{DynamicResource FaintTextBrush}" FontSize="12" Margin="0,4,0,0" />
                                </StackPanel>
                                <Grid Grid.Row="2">
                                    <TextBlock Text="{Binding DetailText}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12"
                                               VerticalAlignment="Center" Margin="0,0,68,0" />
                                    <Button Style="{StaticResource SecondaryButton}" Content="Edit"
                                            HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Padding="12,5" Click="EditMachine_Click" />
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <TextBlock x:Name="FooterStatus" Foreground="{DynamicResource MutedTextBrush}" Text="Ready" />
            <TextBlock HorizontalAlignment="Right" Foreground="{DynamicResource FaintTextBrush}" Text="LAN-only remote management" />
        </Grid>
    </Grid>
</Window>
