<Window x:Class="GrevUltraVNC.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:GrevUltraVNC.Converters"
        xmlns:svc="clr-namespace:GrevUltraVNC.Services"
        Title="GrevUltraVNC" Width="1180" Height="790" MinWidth="900" MinHeight="600"
        Style="{StaticResource AppWindowStyle}"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextBrush}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <conv:MachineStatusBrushConverter x:Key="StatusBrushConverter" />
    </Window.Resources>

    <Grid Background="{DynamicResource WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Branded header -->
        <Border Grid.Row="0" Background="{DynamicResource SubtlePanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="30,22">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="70" Height="70" CornerRadius="17" Background="#030509" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <Image Source="{x:Static svc:BrandAssets.Logo}" Margin="3" Stretch="Uniform" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Grev" FontSize="31" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock Text="UltraVNC" FontSize="31" FontWeight="Bold" Margin="1,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="LAN remote management" Foreground="{DynamicResource MutedTextBrush}" FontSize="13" Margin="1,3,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource SecondaryButton}" Content="↻ Refresh" Click="Refresh_Click" Margin="0,0,10,0" />
                    <Button Style="{StaticResource SecondaryButton}" Content="⚙ Settings" Click="Settings_Click" Margin="0,0,10,0" />
                    <Button Style="{StaticResource PrimaryButton}" Content="＋ Add PC" Click="AddMachine_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Search / filters -->
        <Grid Grid.Row="1" Margin="30,22,30,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="YOUR MACHINES" Foreground="{DynamicResource AccentBrush}" FontSize="12" FontWeight="SemiBold" Margin="1,0,0,7" />
                <Grid MaxWidth="620" HorizontalAlignment="Left">
                    <TextBox x:Name="SearchBox" Width="420" HorizontalAlignment="Left" TextChanged="SearchBox_TextChanged"
                             ToolTip="Search name, IP, group or notes" Padding="34,10,10,10" />
                    <TextBlock Text="⌕" FontSize="19" Foreground="{DynamicResource MutedTextBrush}" Margin="10,0,0,0"
                               HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" />
                </Grid>
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                <CheckBox x:Name="FavoritesOnlyCheck" Content="★ Favourites only" Checked="FavoritesOnlyCheck_Changed" Unchecked="FavoritesOnlyCheck_Changed" />
                <TextBlock x:Name="FilterSummaryText" Foreground="{DynamicResource FaintTextBrush}" HorizontalAlignment="Right" FontSize="11" Margin="0,6,0,0" />
            </StackPanel>
        </Grid>

        <!-- Machine cards -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Background="{DynamicResource WindowBrush}" Margin="30,0,14,0">
            <ItemsControl ItemsSource="{Binding MachinesView}" Background="{DynamicResource WindowBrush}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="350" Height="232" Margin="0,0,16,16" Padding="18"
                                Style="{StaticResource MachineCardStyle}" Cursor="Hand"
                                MouseLeftButtonDown="MachineCard_MouseLeftButtonDown"
                                MouseRightButtonUp="MachineCard_MouseRightButtonUp">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource IconButton}" Content="{Binding FavoriteGlyph}" Click="FavoriteMachine_Click"
                                                ToolTip="Toggle favourite" Margin="0,0,10,0" />
                                        <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="7" Padding="8,4" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Group}" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="SemiBold" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding StatusText}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Foreground="{Binding Status, Converter={StaticResource StatusBrushConverter}}"
                                               FontWeight="SemiBold" FontSize="11" />
                                </Grid>

                                <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="2,8,2,8">
                                    <TextBlock Text="{Binding Name}" FontSize="23" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding IpAddress}" Foreground="{DynamicResource MutedTextBrush}" FontSize="13" Margin="0,5,0,0" />
                                    <TextBlock Text="{Binding DetailText}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,11,0,0" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding LastCheckedText}" Foreground="{DynamicResource FaintTextBrush}" FontSize="11" Margin="0,4,0,0" />
                                </StackPanel>

                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button Style="{StaticResource PrimaryButton}" Content="Connect" Click="ConnectMachine_Click" Margin="0,0,8,0" />
                                    <Button Grid.Column="1" Style="{StaticResource CardActionButton}" Content="Edit" Click="EditMachine_Click" Margin="0,0,8,0" />
                                    <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="⋯" Click="MoreMachine_Click" ToolTip="Machine actions" />
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="3" Background="{DynamicResource SubtlePanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="30,13">
            <Grid>
                <TextBlock x:Name="FooterStatus" Foreground="{DynamicResource MutedTextBrush}" Text="Ready" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="Double-click = connect" Foreground="{DynamicResource FaintTextBrush}" Margin="0,0,18,0" />
                    <TextBlock Text="LAN-only remote management" Foreground="{DynamicResource FaintTextBrush}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
