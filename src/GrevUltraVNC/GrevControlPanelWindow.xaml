<Window x:Class="GrevUltraVNC.GrevControlPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:GrevUltraVNC.Services"
        Title="Grev Control Panel"
        Width="300" Height="720" MinHeight="560"
        ResizeMode="NoResize" WindowStyle="ToolWindow"
        ShowInTaskbar="False" Topmost="True"
        Icon="{x:Static svc:BrandAssets.Logo}"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextBrush}">
    <Border Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{DynamicResource WindowBrush}">
            <StackPanel Margin="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="46" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="40" Height="40" CornerRadius="10" Background="#030509" BorderBrush="{DynamicResource Accent2Brush}" BorderThickness="1">
                        <Image Source="{x:Static svc:BrandAssets.Logo}" Margin="2" Stretch="Uniform" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                        <TextBlock Text="GREV CONTROL PANEL" Foreground="{DynamicResource AccentBrush}" FontSize="10" FontWeight="Bold" />
                        <TextBlock x:Name="MachineNameText" FontSize="18" FontWeight="Bold" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
                <TextBlock x:Name="MachineAddressText" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" Margin="2,6,0,0" />

                <Border Background="{DynamicResource SubtlePanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="9" Padding="10" Margin="0,12,0,0">
                    <StackPanel>
                        <Grid>
                            <TextBlock x:Name="SessionStatusText" Text="● VIEWER ACTIVE" Foreground="#50DC91" FontSize="10" FontWeight="SemiBold" />
                            <TextBlock x:Name="AgentConnectionText" Text="AGENT CHECKING" HorizontalAlignment="Right" Foreground="{DynamicResource FaintTextBrush}" FontSize="10" FontWeight="SemiBold" />
                        </Grid>
                        <TextBlock x:Name="AgentCpuRamText" Text="CPU / RAM waiting for Grev Agent" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" Margin="0,5,0,0" />
                    </StackPanel>
                </Border>

                <StackPanel Visibility="Collapsed">
                    <TextBlock x:Name="AgentUserUptimeText" />
                    <TextBlock x:Name="AgentVncHealthText" />
                    <TextBlock x:Name="AgentDiskText" />
                    <Button x:Name="UpdateAgentButton" Click="UpdateAgent_Click" />
                    <TextBlock x:Name="AgentUpdateStatusText" />
                </StackPanel>

                <TextBlock Text="VNC" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,16,0,8" />
                <UniformGrid Columns="2">
                    <Button Style="{StaticResource CardActionButton}" Content="Bring to front" Click="BringToFront_Click" Margin="0,0,4,7" />
                    <Button Style="{StaticResource CardActionButton}" Content="Fullscreen" Click="FullScreen_Click" Margin="4,0,0,7" />
                    <Button Style="{StaticResource CardActionButton}" Content="Refresh screen" Click="RefreshScreen_Click" Margin="0,0,4,7" />
                    <Button Style="{StaticResource CardActionButton}" Content="File transfer" Click="FileTransfer_Click" Margin="4,0,0,7" />
                </UniformGrid>
                <Button Style="{StaticResource DangerButton}" Content="Disconnect VNC" Click="Disconnect_Click" Padding="12,7" />

                <TextBlock Text="REMOTE KEYS" Foreground="{DynamicResource Accent2Brush}" FontSize="11" FontWeight="SemiBold" Margin="0,16,0,8" />
                <UniformGrid Columns="2">
                    <Button Style="{StaticResource CardActionButton}" Content="Ctrl+Alt+Del" Click="Cad_Click" Margin="0,0,4,7" />
                    <Button Style="{StaticResource CardActionButton}" Content="Windows ⊞" Click="WindowsKey_Click" Margin="4,0,0,7" />
                    <Button Style="{StaticResource CardActionButton}" Content="Task Manager" Click="TaskManager_Click" Margin="0,0,4,7" />
                    <Button Style="{StaticResource CardActionButton}" Content="Alt+Tab" Click="AltTab_Click" Margin="4,0,0,7" />
                    <Button Style="{StaticResource CardActionButton}" Content="Alt+F4" Click="AltF4_Click" Margin="0,0,4,0" />
                    <Button Style="{StaticResource CardActionButton}" Content="Win+R" Click="WinR_Click" Margin="4,0,0,0" />
                </UniformGrid>

                <TextBlock Text="SESSION" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,16,0,8" />
                <StackPanel x:Name="SessionActionPanel" IsEnabled="False">
                    <UniformGrid Columns="2">
                        <Button Style="{StaticResource CardActionButton}" Content="🔒 Lock" Click="LockMachine_Click" Margin="0,0,4,0" />
                        <Button Style="{StaticResource CardActionButton}" Content="↻ Explorer" Click="RestartExplorerAgent_Click" Margin="4,0,0,0" />
                    </UniformGrid>
                </StackPanel>

                <TextBlock Text="POWER" Foreground="{DynamicResource Accent2Brush}" FontSize="11" FontWeight="SemiBold" Margin="0,16,0,8" />
                <UniformGrid Columns="2">
                    <Button Style="{StaticResource SecondaryButton}" Content="↻ Restart" Click="Restart_Click" Margin="0,0,4,0" />
                    <Button Style="{StaticResource DangerButton}" Content="⏻ Shut down" Click="Shutdown_Click" Margin="4,0,0,0" Padding="11,7" />
                </UniformGrid>

                <Button Style="{StaticResource PrimaryButton}" Content="Manage machine" Click="ManageMachine_Click" Margin="0,18,0,0" />
                <Button Style="{StaticResource SecondaryButton}" Content="Hide panel" Click="HidePanel_Click" Margin="0,7,0,0" />
                <TextBlock Text="Full maintenance, Agent controls, services, tools and history are in Manage."
                           Foreground="{DynamicResource FaintTextBrush}" FontSize="9" TextWrapping="Wrap" Margin="2,7,2,0" />
            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
