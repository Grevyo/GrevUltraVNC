<Window x:Class="GrevUltraVNC.GrevControlPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:GrevUltraVNC.Services"
        Title="Grev Control Panel"
        Width="420" Height="820" MinHeight="520" MaxHeight="960"
        ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True"
        ShowInTaskbar="False" Topmost="True"
        ContentRendered="CompactPanel_ContentRendered" Closed="CompactPanel_Closed"
        Icon="{x:Static svc:BrandAssets.Logo}"
        Background="Transparent"
        Foreground="{DynamicResource TextBrush}">
    <Window.Resources>
        <Style x:Key="PanelSectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource FaintTextBrush}" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="2,0,0,6" />
        </Style>

        <Style x:Key="PanelActionButton" TargetType="Button" BasedOn="{StaticResource CardActionButton}">
            <Setter Property="Padding" Value="9,7" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="MinHeight" Value="34" />
        </Style>

        <Style x:Key="ToolIconButton" TargetType="Button" BasedOn="{StaticResource CardActionButton}">
            <Setter Property="Padding" Value="4" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Margin" Value="2" />
        </Style>

        <Style x:Key="KeyButton" TargetType="Button" BasedOn="{StaticResource CardActionButton}">
            <Setter Property="Padding" Value="5,6" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Margin" Value="2" />
        </Style>

        <Style x:Key="TinyStatusButton" TargetType="Button" BasedOn="{StaticResource CardActionButton}">
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="MinHeight" Value="26" />
        </Style>

        <Style x:Key="ScaleButton" TargetType="Button" BasedOn="{StaticResource CardActionButton}">
            <Setter Property="Padding" Value="5,5" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Margin" Value="2" />
        </Style>
    </Window.Resources>

    <Border Margin="8" CornerRadius="18"
            Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="5" Opacity="0.55" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Padding="14,11,12,10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="38" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="32" Height="32" CornerRadius="9" Background="#030509"
                            BorderBrush="{DynamicResource Accent2Brush}" BorderThickness="1">
                        <Image Source="{x:Static svc:BrandAssets.Logo}" Margin="2" Stretch="Uniform" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="7,0,8,0">
                        <TextBlock Text="GREV CONTROL" Foreground="{DynamicResource AccentBrush}"
                                   FontSize="8" FontWeight="Bold" />
                        <TextBlock x:Name="MachineNameText" FontSize="16" FontWeight="SemiBold"
                                   Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="—"
                            Click="HidePanel_Click" ToolTip="Hide control panel" Padding="7,4"
                            MinWidth="30" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Border Grid.Row="1" Margin="12,9,12,0" Padding="10,7" CornerRadius="10"
                    Background="{DynamicResource SubtlePanelBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel MinWidth="0">
                        <TextBlock x:Name="MachineAddressText" Foreground="{DynamicResource MutedTextBrush}"
                                   FontSize="8" TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock x:Name="SessionStatusText" Text="● SCREEN 1 ACTIVE" Foreground="#50DC91"
                                       FontSize="8" FontWeight="SemiBold" Margin="0,0,8,0" />
                            <TextBlock x:Name="AgentCpuRamText" Text="CPU / RAM waiting"
                                       Foreground="{DynamicResource FaintTextBrush}" FontSize="8"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock x:Name="AgentConnectionText" Grid.Column="1" Text="AGENT CHECKING"
                               VerticalAlignment="Center" Margin="8,0,0,0"
                               Foreground="{DynamicResource FaintTextBrush}" FontSize="8" FontWeight="SemiBold" />
                </Grid>
            </Border>

            <StackPanel Visibility="Collapsed">
                <TextBlock x:Name="AgentUserUptimeText" />
                <TextBlock x:Name="AgentVncHealthText" />
                <TextBlock x:Name="AgentDiskText" />
                <Button x:Name="UpdateAgentButton" Click="UpdateAgent_Click" />
                <TextBlock x:Name="AgentUpdateStatusText" />
            </StackPanel>

            <ScrollViewer x:Name="PanelScrollViewer" Grid.Row="2"
                          VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled"
                          Margin="0,8,0,0" Padding="0" CanContentScroll="False">
                <StackPanel Margin="12,0,12,6">
                    <TextBlock Text="VIEWER" Style="{StaticResource PanelSectionLabel}" />
                    <Border Background="{DynamicResource SubtlePanelBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="12" Padding="8">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Style="{StaticResource PanelActionButton}"
                                        Content="▣  Screen 1" Click="BringToFront_Click"
                                        ToolTip="Bring the physical display viewer to the front"
                                        Margin="0,0,3,0" />
                                <Button x:Name="VirtualDisplayButton" Grid.Column="1"
                                        Style="{StaticResource PanelActionButton}"
                                        Content="＋  Screen 2" Click="CreateScreen2_Click"
                                        ToolTip="Create or focus Grev virtual Screen 2"
                                        Margin="3,0" />
                                <Button x:Name="CloseVirtualDisplayButton" Grid.Column="2"
                                        Visibility="Collapsed" Style="{StaticResource TinyStatusButton}"
                                        Content="×" Click="CloseScreen2_Click"
                                        ToolTip="Close Screen 2" FontSize="14" Margin="3,0,0,0" />
                            </Grid>
                            <TextBlock x:Name="DisplayStatusText" Text="Screen 1 · physical display"
                                       Foreground="{DynamicResource FaintTextBrush}" FontSize="8"
                                       Margin="2,0,2,7" TextTrimming="CharacterEllipsis" />

                            <Border Margin="0,0,0,7" Padding="9,7" CornerRadius="9"
                                    Background="{DynamicResource PanelBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                        <TextBlock Text="REMOTE INPUT" Foreground="{DynamicResource FaintTextBrush}"
                                                   FontSize="8" FontWeight="SemiBold" />
                                        <TextBlock x:Name="ControlStatusText"
                                                   Text="VIEW ONLY · no one has control"
                                                   Foreground="{DynamicResource MutedTextBrush}" FontSize="8"
                                                   Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Button x:Name="TakeControlButton" Grid.Column="1"
                                            Style="{StaticResource PrimaryButton}" Content="Take control"
                                            Click="TakeControl_Click" IsEnabled="False"
                                            Padding="11,6" MinWidth="98" />
                                </Grid>
                            </Border>

                            <Grid Margin="2,0,2,3">
                                <TextBlock Text="VIEW SIZE" Foreground="{DynamicResource FaintTextBrush}"
                                           FontSize="8" FontWeight="SemiBold" />
                                <TextBlock x:Name="ZoomStatusText" Text="Fit" HorizontalAlignment="Right"
                                           Foreground="{DynamicResource AccentBrush}" FontSize="8" FontWeight="SemiBold" />
                            </Grid>
                            <UniformGrid Columns="5" Margin="-2,0,-2,2">
                                <Button Style="{StaticResource ScaleButton}" Content="10%" Tag="10" Click="ViewerScale_Click" />
                                <Button Style="{StaticResource ScaleButton}" Content="25%" Tag="25" Click="ViewerScale_Click" />
                                <Button Style="{StaticResource ScaleButton}" Content="50%" Tag="50" Click="ViewerScale_Click" />
                                <Button Style="{StaticResource ScaleButton}" Content="75%" Tag="75" Click="ViewerScale_Click" />
                                <Button Style="{StaticResource ScaleButton}" Content="100%" Tag="100" Click="ViewerScale_Click" />
                                <Button Style="{StaticResource ScaleButton}" Content="125%" Tag="125" Click="ViewerScale_Click" />
                                <Button Style="{StaticResource ScaleButton}" Content="150%" Tag="150" Click="ViewerScale_Click" />
                                <Button Style="{StaticResource ScaleButton}" Content="200%" Tag="200" Click="ViewerScale_Click" />
                                <Button Style="{StaticResource ScaleButton}" Content="300%" Tag="300" Click="ViewerScale_Click" />
                                <Button Style="{StaticResource ScaleButton}" Content="Fit" Tag="fit" Click="ViewerScale_Click" />
                            </UniformGrid>
                            <Grid Margin="4,0,4,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="38" />
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="ViewerScaleSlider" Minimum="10" Maximum="300" Value="100"
                                        TickFrequency="5" IsSnapToTickEnabled="True"
                                        ValueChanged="ViewerScaleSlider_ValueChanged"
                                        PreviewMouseLeftButtonDown="ViewerScaleSlider_PreviewMouseLeftButtonDown"
                                        PreviewMouseLeftButtonUp="ViewerScaleSlider_PreviewMouseLeftButtonUp"
                                        LostMouseCapture="ViewerScaleSlider_LostMouseCapture"
                                        VerticalAlignment="Center" ToolTip="Viewer scale 10%–300%" />
                                <TextBlock Grid.Column="1" Text="300%" HorizontalAlignment="Right"
                                           VerticalAlignment="Center" Foreground="{DynamicResource FaintTextBrush}" FontSize="8" />
                            </Grid>

                            <Grid Margin="2,0,2,3">
                                <TextBlock Text="TOOLS" Foreground="{DynamicResource FaintTextBrush}"
                                           FontSize="8" FontWeight="SemiBold" />
                                <TextBlock Text="hover for action" HorizontalAlignment="Right"
                                           Foreground="{DynamicResource FaintTextBrush}" FontSize="8" />
                            </Grid>
                            <UniformGrid Columns="6" Margin="-2,0,-2,0">
                                <Button Style="{StaticResource ToolIconButton}" Content="↥"
                                        Click="BringToFront_Click" ToolTip="Bring Screen 1 to front" />
                                <Button Style="{StaticResource ToolIconButton}" Content="⛶"
                                        Click="FullScreen_Click" ToolTip="Toggle fullscreen" />
                                <Button Style="{StaticResource ToolIconButton}" Content="↻"
                                        Click="RefreshScreen_Click" ToolTip="Refresh remote screen" />
                                <Button Style="{StaticResource ToolIconButton}" Content="⇄"
                                        Click="FileTransfer_Click" ToolTip="UltraVNC file transfer" />
                                <Button x:Name="AudioButton" Style="{StaticResource ToolIconButton}"
                                        Content="🔊" Click="Audio_Click" ToolTip="Toggle computer sound"
                                        IsEnabled="False">
                                    <Button.ContentTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="🔊" FontSize="15" />
                                        </DataTemplate>
                                    </Button.ContentTemplate>
                                </Button>
                                <Button x:Name="WhiteboardButton" Style="{StaticResource ToolIconButton}"
                                        Content="✎" Click="Whiteboard_Click" ToolTip="Shared whiteboard"
                                        IsEnabled="False" />
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <Grid Margin="2,9,2,5">
                        <TextBlock Text="REMOTE KEYS" Style="{StaticResource PanelSectionLabel}" Margin="0" />
                        <TextBlock Text="CONTROL REQUIRED" HorizontalAlignment="Right"
                                   Foreground="{DynamicResource FaintTextBrush}" FontSize="8" />
                    </Grid>
                    <Border x:Name="RemoteKeysPanel" IsEnabled="False"
                            Background="{DynamicResource SubtlePanelBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="12" Padding="6">
                        <UniformGrid Columns="6" Margin="-2">
                            <Button Style="{StaticResource KeyButton}" Content="CAD"
                                    Click="Cad_Click" ToolTip="Ctrl + Alt + Delete" />
                            <Button Style="{StaticResource KeyButton}" Content="⊞"
                                    Click="WindowsKey_Click" ToolTip="Windows key" FontSize="14" />
                            <Button Style="{StaticResource KeyButton}" Content="TASK"
                                    Click="TaskManager_Click" ToolTip="Task Manager" />
                            <Button Style="{StaticResource KeyButton}" Content="ALT↹"
                                    Click="AltTab_Click" ToolTip="Alt + Tab" />
                            <Button Style="{StaticResource KeyButton}" Content="ALT F4"
                                    Click="AltF4_Click" ToolTip="Alt + F4" />
                            <Button Style="{StaticResource KeyButton}" Content="WIN R"
                                    Click="WinR_Click" ToolTip="Run dialog" />
                        </UniformGrid>
                    </Border>

                    <TextBlock Text="PC" Style="{StaticResource PanelSectionLabel}" Margin="2,9,0,5" />
                    <Border Background="{DynamicResource SubtlePanelBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="12" Padding="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="54" />
                                <ColumnDefinition Width="54" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel x:Name="SessionActionPanel" Grid.ColumnSpan="2"
                                        Orientation="Horizontal" IsEnabled="False">
                                <Button Style="{StaticResource ToolIconButton}" Content="🔒"
                                        Click="LockMachine_Click" ToolTip="Lock workstation"
                                        Width="48" Margin="0,0,4,0" />
                                <Button Style="{StaticResource ToolIconButton}" Content="↻"
                                        Click="RestartExplorerAgent_Click" ToolTip="Restart Windows Explorer"
                                        Width="48" Margin="0" />
                            </StackPanel>

                            <Button Grid.Column="2" Style="{StaticResource PanelActionButton}"
                                    Content="Restart PC" Click="Restart_Click" Margin="4,2,3,2" />
                            <Button Grid.Column="3" Style="{StaticResource DangerButton}"
                                    Content="Shut down" Click="Shutdown_Click" Margin="3,2,2,2"
                                    Padding="8,7" FontSize="10" MinHeight="34" />
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="3" Margin="12,2,12,7" Padding="9,7" CornerRadius="11"
                    Background="{DynamicResource SubtlePanelBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <StackPanel>
                    <Grid Margin="1,0,1,3">
                        <TextBlock x:Name="ParticipantsHeaderText" Text="CONNECTED · checking"
                                   Foreground="{DynamicResource AccentBrush}" FontSize="8" FontWeight="SemiBold" />
                        <TextBlock x:Name="CollaborationStatusText" Text="Grev Collaboration"
                                   HorizontalAlignment="Right" Foreground="{DynamicResource FaintTextBrush}" FontSize="8" />
                    </Grid>
                    <ItemsControl x:Name="ParticipantsItems" Margin="1,1,1,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource PanelBrush}" CornerRadius="7"
                                        Padding="6,2" Margin="0,0,4,2">
                                    <TextBlock Text="{Binding}" Foreground="{DynamicResource MutedTextBrush}" FontSize="8" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Grid.Row="4" Padding="12,8,12,10"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource PrimaryButton}" Content="Manage machine"
                            Click="ManageMachine_Click" Padding="13,7" Margin="0,0,6,0" />
                    <Button Grid.Column="1" Style="{StaticResource DangerButton}" Content="Disconnect"
                            Click="Disconnect_Click" Padding="11,7" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>