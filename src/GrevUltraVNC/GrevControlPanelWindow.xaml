<Window x:Class="GrevUltraVNC.GrevControlPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Grev Control Panel"
        Width="270" Height="680" MinHeight="500"
        ResizeMode="NoResize" WindowStyle="ToolWindow"
        ShowInTaskbar="False" Topmost="True"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextBrush}">
    <Border Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{DynamicResource WindowBrush}">
            <StackPanel Margin="16">
                <TextBlock Text="GREV CONTROL PANEL" Foreground="{DynamicResource AccentBrush}" FontSize="12" FontWeight="Bold" />
                <TextBlock x:Name="MachineNameText" FontSize="22" FontWeight="Bold" Margin="0,5,0,0" />
                <TextBlock x:Name="MachineAddressText" Foreground="{DynamicResource MutedTextBrush}" Margin="0,3,0,0" />

                <Border Background="{DynamicResource SubtlePanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,14,0,0">
                    <Grid>
                        <TextBlock Text="VNC SESSION" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" FontWeight="SemiBold" />
                        <TextBlock x:Name="SessionStatusText" Text="● Viewer active" HorizontalAlignment="Right" Foreground="#50DC91" FontSize="11" FontWeight="SemiBold" />
                    </Grid>
                </Border>

                <TextBlock Text="REMOTE KEYS" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,18,0,8" />
                <Button Style="{StaticResource SecondaryButton}" Content="Ctrl + Alt + Delete" Click="Cad_Click" Margin="0,0,0,8" />
                <Button Style="{StaticResource SecondaryButton}" Content="Windows ⊞" Click="WindowsKey_Click" Margin="0,0,0,8" />
                <Button Style="{StaticResource SecondaryButton}" Content="Ctrl + Shift + Esc" Click="TaskManager_Click" />

                <TextBlock Text="SESSION" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,18,0,8" />
                <Button Style="{StaticResource SecondaryButton}" Content="Bring VNC to front" Click="BringToFront_Click" Margin="0,0,0,8" />
                <Button Style="{StaticResource DangerButton}" Content="Disconnect VNC" Click="Disconnect_Click" />

                <TextBlock Text="MACHINE" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,18,0,8" />
                <Button Style="{StaticResource SecondaryButton}" Content="⚡ Wake machine" Click="Wake_Click" Margin="0,0,0,8" />
                <Button Style="{StaticResource SecondaryButton}" Content="↻ Restart machine" Click="Restart_Click" Margin="0,0,0,8" />
                <Button Style="{StaticResource DangerButton}" Content="⏻ Shut down machine" Click="Shutdown_Click" />

                <TextBlock Text="TOOLS" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,18,0,8" />
                <Button Style="{StaticResource SecondaryButton}" Content="📁 Open network shares" Click="Shares_Click" Margin="0,0,0,8" />
                <Button Style="{StaticResource SecondaryButton}" Content="📡 Ping / connection info" Click="Diagnostics_Click" />

                <Button Style="{StaticResource SecondaryButton}" Content="Hide Grev Control Panel" Click="HidePanel_Click" Margin="0,20,0,4" />
                <TextBlock Text="The panel follows the UltraVNC Viewer and closes automatically when the VNC session ends."
                           Foreground="{DynamicResource FaintTextBrush}" FontSize="10" TextWrapping="Wrap" Margin="2,6,2,0" />
            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
