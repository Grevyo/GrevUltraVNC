<Window x:Class="GrevUltraVNC.RemoteFileManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:GrevUltraVNC.Services"
        Title="GrevUltraVNC · Remote files"
        Width="1040" Height="700" MinWidth="860" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource AppWindowStyle}"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextBrush}">
    <Grid Background="{DynamicResource WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="{DynamicResource SubtlePanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="22,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="42" Height="42" CornerRadius="10" Background="{DynamicResource LogoPlateBrush}" BorderBrush="{DynamicResource Accent2Brush}" BorderThickness="1">
                    <Image Source="{x:Static svc:BrandAssets.Logo}" Margin="3" Stretch="Uniform" />
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="REMOTE FILES" Foreground="{DynamicResource AccentBrush}" FontSize="10" FontWeight="Bold" />
                    <TextBlock x:Name="MachineNameText" FontSize="23" FontWeight="Bold" Margin="0,1,0,0" />
                </StackPanel>
                <Border Grid.Column="2" Style="{StaticResource Pill}" Padding="10,5">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔒" FontSize="11" VerticalAlignment="Center" Margin="0,0,7,0" />
                        <TextBlock x:Name="SecurityText" Text="Encrypted Agent file channel"
                                   Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="{DynamicResource WindowBrush}" Padding="22,12,22,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource SecondaryButton}" Content="Drives" Click="Drives_Click" Padding="12,7" Margin="0,0,7,0" />
                <Button Grid.Column="1" x:Name="UpButton" Style="{StaticResource SecondaryButton}" Content="↑ Up" Click="Up_Click" Padding="12,7" Margin="0,0,7,0" IsEnabled="False" />
                <TextBox Grid.Column="2" x:Name="PathBox" KeyDown="PathBox_KeyDown" Padding="10,7" Margin="0,0,7,0" ToolTip="Remote path" />
                <Button Grid.Column="3" Style="{StaticResource PrimaryButton}" Content="Go" Click="Go_Click" Padding="14,7" Margin="0,0,7,0" />
                <Button Grid.Column="4" Style="{StaticResource SecondaryButton}" Content="↻" Click="Refresh_Click" Padding="12,7" ToolTip="Refresh folder" />
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="22,0,22,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Margin="14,0,14,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="200" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="1" Text="NAME" Style="{StaticResource MicroLabel}" />
                <TextBlock Grid.Column="2" Text="SIZE" Style="{StaticResource MicroLabel}" TextAlignment="Right" />
                <TextBlock Grid.Column="3" Text="MODIFIED" Style="{StaticResource MicroLabel}" Margin="14,0,0,0" />
                <TextBlock Grid.Column="4" Text="DETAILS" Style="{StaticResource MicroLabel}" />
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource CardSurface}" Padding="10">
                <ListView x:Name="FilesList" Background="Transparent" BorderThickness="0"
                          Foreground="{DynamicResource TextBrush}"
                          ItemContainerStyle="{StaticResource DataRowItem}"
                          ScrollViewer.CanContentScroll="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          MouseDoubleClick="FilesList_MouseDoubleClick">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="3,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="200" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Glyph}" FontSize="13" VerticalAlignment="Center"
                                           ToolTip="{Binding Type}" />
                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,14,0" />
                                <TextBlock Grid.Column="2" Text="{Binding Size}" TextAlignment="Right"
                                           Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="{Binding Modified}" Margin="14,0,0,0"
                                           Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="4" Text="{Binding Detail}" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource FaintTextBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>
        </Grid>

        <Border Grid.Row="3" Margin="22,0,22,10" Background="{DynamicResource SubtlePanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource SecondaryButton}" Content="New folder" Click="NewFolder_Click" Padding="11,7" Margin="0,0,6,0" />
                    <Button Style="{StaticResource SecondaryButton}" Content="Rename" Click="Rename_Click" Padding="11,7" Margin="0,0,6,0" />
                    <Button Style="{StaticResource SecondaryButton}" Content="Copy" Click="Copy_Click" Padding="11,7" Margin="0,0,6,0" />
                    <Button Style="{StaticResource SecondaryButton}" Content="Cut" Click="Cut_Click" Padding="11,7" Margin="0,0,6,0" />
                    <Button x:Name="PasteButton" Style="{StaticResource PrimaryButton}" Content="Paste" Click="Paste_Click" Padding="12,7" IsEnabled="False" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource SecondaryButton}" Content="Upload" Click="Upload_Click" Padding="12,7" Margin="0,0,6,0" />
                    <Button Style="{StaticResource SecondaryButton}" Content="Download" Click="Download_Click" Padding="12,7" Margin="0,0,6,0" />
                    <Button Style="{StaticResource DangerButton}" Content="Delete" Click="Delete_Click" Padding="12,7" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="4" Background="{DynamicResource SubtlePanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="22,9">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <TextBlock x:Name="StatusText" Text="Ready" Style="{StaticResource CaptionText}" />
                    <TextBlock x:Name="ClipboardStatusText" HorizontalAlignment="Right" Style="{StaticResource MicroLabel}" FontWeight="Normal" />
                </Grid>
                <ProgressBar x:Name="TransferProgress" Grid.Row="1" Style="{StaticResource MeterBar}"
                             Margin="0,8,0,0" Value="0" Visibility="Collapsed" />
            </Grid>
        </Border>
    </Grid>
</Window>
