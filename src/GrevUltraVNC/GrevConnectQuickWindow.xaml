<Window x:Class="GrevUltraVNC.GrevConnectQuickWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:GrevUltraVNC.Services"
        Title="Connect with GrevConnect"
        Width="560" Height="575" MinHeight="520" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource AppWindowStyle}"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextBrush}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="58" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="48" Height="48" CornerRadius="12" Background="#05070B"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Image Source="{x:Static svc:BrandAssets.Logo}" Margin="3" Stretch="Uniform" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                <TextBlock Text="Connect to a Grev PC" FontSize="25" FontWeight="Bold" />
                <TextBlock Text="Enter the GrevConnect ID you were given. No IP address archaeology required."
                           Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,3,0,0"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,22,0,18">
            <StackPanel>
                <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="18">
                    <StackPanel>
                        <TextBlock Text="GREVCONNECT ID" Foreground="{DynamicResource AccentBrush}"
                                   FontSize="11" FontWeight="SemiBold" />
                        <TextBox x:Name="ConnectIdBox" Margin="0,10,0,0" FontSize="16" MaxLength="52"
                                 ToolTip="Example: GC-GrevingRoom" />
                        <TextBlock Text="Example · GC-GrevingRoom" Foreground="{DynamicResource FaintTextBrush}"
                                   FontSize="10" Margin="0,6,0,0" />
                        <TextBlock Text="Make sure your Zima / private Grev Connect network is connected first."
                                   Foreground="{DynamicResource MutedTextBrush}" FontSize="11"
                                   Margin="0,12,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Expander Header="First-time pairing  ·  open this the first time you connect"
                          Margin="0,14,0,0" Foreground="{DynamicResource TextBrush}">
                    <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="VNC password" />
                            <PasswordBox x:Name="VncPasswordBox" Margin="0,6,0,0" />
                            <TextBlock Text="Optional here. If it is not already saved, UltraVNC can ask for it when the viewer opens."
                                       Foreground="{DynamicResource FaintTextBrush}" FontSize="10" Margin="0,5,0,0"
                                       TextWrapping="Wrap" />

                            <TextBlock Text="Grev Agent pairing key" Margin="0,16,0,0" />
                            <PasswordBox x:Name="AgentKeyBox" Margin="0,6,0,0" />
                            <TextBlock Text="Required the first time for remote control and Grev features such as collaboration, Manage, Terminal, audio and Screen 2. It is stored securely in Windows Credential Manager."
                                       Foreground="{DynamicResource FaintTextBrush}" FontSize="10"
                                       Margin="0,5,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Expander>

                <Border Background="{DynamicResource SubtlePanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,14,0,0">
                    <TextBlock x:Name="StatusText" Text="Ready when you are."
                               Foreground="{DynamicResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource SecondaryButton}" Content="Cancel" IsCancel="True" Margin="0,0,10,0" />
            <Button x:Name="ConnectButton" Style="{StaticResource PrimaryButton}"
                    Content="Find &amp; Connect" Click="Connect_Click" Padding="16,8" />
        </StackPanel>
    </Grid>
</Window>
