<Window x:Class="GrevUltraVNC.MachineDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Machine" Width="520" Height="690" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Style="{StaticResource AppWindowStyle}"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextBrush}">
    <Grid Margin="26" Background="{DynamicResource WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Machine details" FontSize="26" FontWeight="Bold" />
            <TextBlock Text="Static LAN details used by GrevUltraVNC." Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,24,0,20">
            <StackPanel>
                <TextBlock Text="Name" Margin="0,0,0,6" />
                <TextBox x:Name="NameBox" />
                <TextBlock Text="Static IP" Margin="0,16,0,6" />
                <TextBox x:Name="IpBox" />
                <TextBlock Text="MAC address (for Wake-on-LAN)" Margin="0,16,0,6" />
                <TextBox x:Name="MacBox" />
                <TextBlock Text="VNC port" Margin="0,16,0,6" />
                <TextBox x:Name="PortBox" />

                <TextBlock Text="VNC password" Margin="0,16,0,6" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <PasswordBox x:Name="VncPasswordBox"
                                 Background="{DynamicResource SubtlePanelBrush}"
                                 Foreground="{DynamicResource TextBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}"
                                 BorderThickness="1" Padding="10,8" />
                    <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Forget saved"
                            Click="ForgetPassword_Click" Margin="10,0,0,0" />
                </Grid>
                <TextBlock x:Name="PasswordStateText" Foreground="{DynamicResource MutedTextBrush}" FontSize="11"
                           TextWrapping="Wrap" Margin="2,6,0,0" />

                <TextBlock Text="Group" Margin="0,16,0,6" />
                <TextBox x:Name="GroupBox" />
                <TextBlock Text="Notes" Margin="0,16,0,6" />
                <TextBox x:Name="NotesBox" Height="58" AcceptsReturn="True" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource SecondaryButton}" Content="Cancel" IsCancel="True" Margin="0,0,10,0" />
            <Button Style="{StaticResource PrimaryButton}" Content="Save machine" Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
