<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>GrevUltraVNC</AssemblyName>
    <RootNamespace>GrevUltraVNC</RootNamespace>
    <ApplicationIcon>Assets\GrevUltraVNC.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Update="Assets\GrevUltraVNC.ico.b64" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="DecodeGrevUltraVncIcon" BeforeTargets="PrepareForBuild">
    <Exec Condition="Exists('$(MSBuildProjectDirectory)\Assets\GrevUltraVNC.ico.b64')"
          Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;$b=[IO.File]::ReadAllText('$(MSBuildProjectDirectory)\Assets\GrevUltraVNC.ico.b64'); [IO.File]::WriteAllBytes('$(MSBuildProjectDirectory)\Assets\GrevUltraVNC.ico',[Convert]::FromBase64String($b))&quot;" />
  </Target>
</Project>
