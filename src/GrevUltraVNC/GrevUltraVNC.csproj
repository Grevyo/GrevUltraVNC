<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <!-- Keep WinForms available only for NotifyIcon, but don't import System.Windows.Forms globally into WPF code. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>GrevUltraVNC</AssemblyName>
    <RootNamespace>GrevUltraVNC</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System" />
    <Using Include="System.Collections.Generic" />
    <Using Include="System.IO" />
    <Using Include="System.Linq" />
    <Using Include="System.Threading" />
    <Using Include="System.Threading.Tasks" />
    <!-- BrandAssets decodes this at runtime for WPF window/taskbar and tray branding. -->
    <None Update="Assets\GrevUltraVNC.ico.b64" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
