<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <!-- Keep WinForms available only for NotifyIcon, but don't import System.Windows.Forms globally into WPF code. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>GrevUltraVNC</AssemblyName>
    <RootNamespace>GrevUltraVNC</RootNamespace>
    <Version>1.1.2</Version>
    <AssemblyVersion>1.1.2.0</AssemblyVersion>
    <FileVersion>1.1.2.0</FileVersion>
    <InformationalVersion>1.1.2-friend</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GrevUltraVNC.Contracts\GrevUltraVNC.Contracts.csproj" />
    <PackageReference Include="NAudio" Version="2.3.0" />
    <Using Include="System" />
    <Using Include="System.Collections.Generic" />
    <Using Include="System.IO" />
    <Using Include="System.Linq" />
    <Using Include="System.Threading" />
    <Using Include="System.Threading.Tasks" />
    <!-- BrandAssets decodes the supplied Grev logo at runtime for window/taskbar/tray branding. -->
    <None Update="Assets\GrevLogo256.jpg.b64" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Assets\GrevLogo.jpg.b64" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
