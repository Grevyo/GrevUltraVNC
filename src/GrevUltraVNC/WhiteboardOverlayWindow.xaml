<Window x:Class="GrevUltraVNC.WhiteboardOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Grev Whiteboard"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True">
    <Grid>
        <Canvas x:Name="DrawingCanvas" Background="#01000000"
                MouseLeftButtonDown="DrawingCanvas_MouseLeftButtonDown"
                MouseMove="DrawingCanvas_MouseMove"
                MouseLeftButtonUp="DrawingCanvas_MouseLeftButtonUp" />

        <Border HorizontalAlignment="Center" VerticalAlignment="Top"
                Margin="0,14,0,0" Padding="9,7" CornerRadius="12"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="3" Opacity="0.55" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="✎  GREV WHITEBOARD" Foreground="{DynamicResource AccentBrush}"
                           FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Margin="3,0,12,0" />
                <Button Style="{StaticResource CardActionButton}" Content="Clear all"
                        Click="Clear_Click" Padding="10,6" Margin="0,0,6,0" />
                <Button Style="{StaticResource SecondaryButton}" Content="Done"
                        Click="Done_Click" Padding="10,6" />
            </StackPanel>
        </Border>

        <Border HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Margin="14" Padding="9,6" CornerRadius="9"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                IsHitTestVisible="False">
            <TextBlock Text="Draw anywhere · strokes are shared with connected Grev users"
                       Foreground="{DynamicResource MutedTextBrush}" FontSize="9" />
        </Border>
    </Grid>
</Window>
